#!/bin/sh
set -eu

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || {
  printf '%s\n' 'dev-check: not inside a Git worktree' >&2
  exit 2
}
cd "$ROOT"

printf '%s\n' '== repository contract =='
node scripts/verify-repo.mjs

printf '%s\n' '== lint =='
npm run lint

printf '%s\n' '== unit and regression tests =='
npm run test

printf '%s\n' '== review gate contract tests =='
python3 -m unittest discover -s test_py -p 'test_*.py'

printf '%s\n' '== typecheck =='
npm run typecheck

printf '%s\n' '== build =='
npm run build:check

printf '%s\n' '== Cloudflare build and deploy dry-run =='
npm run cloudflare:check

printf '%s\n' '== goal contract =='
python3 tools/check_goal_contract.py

printf '%s\n' '== reverse trace promises =='
python3 tools/reverse_trace/check_current.py

printf '%s\n' '== shell syntax =='
sh -n tools/dev/check tools/dev/provider-adapter-readiness tools/dev/observability-readiness tools/ci/build-check tools/ci/mutation-test tools/pr/codex-review-status.sh tools/pr/codex-review-wait.sh

printf '%s\n' '== whitespace =='
git diff --check
git diff --cached --check

printf '%s\n' 'DEV_CHECK_PASS'
