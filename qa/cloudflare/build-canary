#!/bin/sh
# Offline only. Explicit output path, no provider API calls.
set -eu
test "$#" -eq 1
cd "$(dirname "$0")/../.."
test -x node_modules/.bin/esbuild
node_modules/.bin/esbuild qa/cloudflare/hyperdrive-canary.mjs --bundle --platform=node --conditions=workerd --format=esm --target=es2022 --external:pg-native --external:cloudflare:sockets --banner:js="import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);" --outfile="$1"
