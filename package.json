  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@types/node": "latest",
    "mastra": "latest",
    "typescript": "6.0.3"
  },
