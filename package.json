{
  "name": "theseus-dreaming-worker",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build",
    "start": "mastra start",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "./tools/dev/check",
    "pilot0": "node tools/run-pilot0.mjs",
    "lint": "biome lint src test tools scripts package.json biome.json cloudflare.config.ts vite.config.ts --diagnostic-level=error",
    "mutation": "./tools/ci/mutation-test",
    "build:check": "./tools/ci/build-check",
    "pilot1": "node tools/agent/run-pilot1.mjs",
    "agent:check": "node tools/agent/sync-pilot1.mjs --check",
    "agent:apply": "node tools/agent/sync-pilot1.mjs --apply",
    "cloudflare:build": "cf build",
    "cloudflare:dry-run": "cf deploy --dry-run --no-provision",
    "cloudflare:check": "tools/dev/cloudflare-check",
    "cloudflare:startup-check": "cf workers check",
    "cloudflare:schema": "node tools/cloudflare/export-postgres-schema.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "1.0.63",
    "@mastra/core": "latest",
    "@mastra/editor": "latest",
    "@mastra/hono": "1.7.27",
    "@mastra/langfuse": "1.7.1",
    "@mastra/libsql": "latest",
    "@mastra/mcp": "^2.10.0",
    "@mastra/observability": "latest",
    "@mastra/otel-exporter": "1.6.1",
    "@mastra/pg": "1.37.0",
    "@opentelemetry/api": "1.9.0",
    "hono": "4.13.19",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@cloudflare/vite-plugin": "2.0.0-rc.3",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@types/node": "latest",
    "cf": "1.0.0-rc.2",
    "mastra": "latest",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.3.0"
}
