# No provider API keys are stored in this project.
# Model traffic uses exe.dev provider integrations attached to the primary VM.

# Optional Builder model. No model is selected when unset or blank.
BUILDER_MODEL=

# Keep Studio focused on provider routes registered by this project.
AUTO_BLOCK_EXTERNAL_PROVIDERS=true

# Production-only: Agent Builder requires an Enterprise license outside development.
MASTRA_EE_LICENSE=

# Optional external observability. Missing values keep the service local-only.
# Grafana Cloud / any OTLP-compatible endpoint. Use the base OTLP endpoint; Mastra appends /v1/traces.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=

# Langfuse semantic LLM observability. Both keys are required to enable it.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Optional non-sensitive trace labels.
THESEUS_ENVIRONMENT=development
THESEUS_RELEASE=
