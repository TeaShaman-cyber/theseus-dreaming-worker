# No provider API keys are stored in this project.
# Model traffic uses exe.dev provider integrations attached to the primary VM.

# The Builder's own model. Change this without changing provider code.
BUILDER_MODEL=exe/nvidia/moonshotai/kimi-k3.1-pro

# Keep Studio focused on provider routes registered by this project.
AUTO_BLOCK_EXTERNAL_PROVIDERS=true

# Production-only: Agent Builder requires an Enterprise license outside development.
MASTRA_EE_LICENSE=
